config CI_UDC
	bool "ChipIdea device controller"
	depends on !DM_USB_GADGET
	select USB_GADGET_DUALSPEED
	help
	  Say Y here to enable device controller functionality of the
	  ChipIdea driver.

config USB_GADGET_VBUS_DRAW
	int "Maximum VBUS Power usage (2-500 mA)"
	range 2 500
	default 2
	help
	   Some devices need to draw power from USB when they are
	   configured, perhaps to operate circuitry or to recharge
	   batteries.  This is in addition to any local power supply,
	   such as an AC adapter or batteries.

	   Enter the maximum power your device draws through USB, in
	   milliAmperes.  The permitted range of values is 2 - 500 mA;
	   0 mA would be legal, but can make some hosts misbehave.

	   This value will be used except for system-specific gadget
	   drivers that have more specific information.

config SDP_LOADADDR
	hex "Default load address at SDP_WRITE and SDP_JUMP"
	default 0x0

# Selected by UDC drivers that support high-speed operation.
config USB_GADGET_DUALSPEED
	bool

config USB_GADGET_DOWNLOAD
	bool "Enable USB download gadget"
	help
	  Composite USB download gadget support (g_dnl) for download functions.
	  This code works on top of composite gadget.

if USB_GADGET_DOWNLOAD

config USB_FUNCTION_MASS_STORAGE
	bool "Enable USB mass storage gadget"
	help
	  Enable mass storage protocol support in U-Boot. It allows exporting
	  the eMMC/SD card content to HOST PC so it can be mounted.

config USB_GADGET_MASS_STORAGE_BUFLEN
	hex "Mass storage data buffer size"
	depends on USB_FUNCTION_MASS_STORAGE || SPL_USB_FUNCTION_MASS_STORAGE
	default 0x20000
	help
	  Size of each of the two data buffers of the mass storage function,
	  in bytes; a multiple of 512. It is also the most a single WRITE
	  moves per block-device call. A larger buffer also lengthens each
	  USB-to-storage hand-off: on AML-S905D3-CC 1 MiB was slower than
	  128 KiB in both directions. Two buffers are allocated with malloc
	  in each stage that runs the function.

config USB_GADGET_MASS_STORAGE_READ_FILL
	hex "Mass storage READ fill per block-device call"
	depends on USB_FUNCTION_MASS_STORAGE || SPL_USB_FUNCTION_MASS_STORAGE
	default 0x4000
	help
	  The most one READ fills per block-device call, at most the buffer
	  size. 16 KiB (the default) pipelines the storage read with bulk-IN
	  on MediaTek MT8188's MTU3, where a 16 KiB buffer hung; a card with
	  a large per-command cost may read faster with a larger fill.

config USB_FUNCTION_ROCKUSB
	bool "Enable USB rockusb gadget"
	depends on ARCH_ROCKCHIP
	help
	  Rockusb protocol is widely used by Rockchip SoC based devices. It can
	  read/write info, image to/from devices. This enables the USB part of
	  the rockusb gadget.for more detail about Rockusb protocol, please see
	  doc/README.rockusb

config USB_FUNCTION_SDP
	bool "Enable USB SDP (Serial Download Protocol)"
	help
	  Enable Serial Download Protocol (SDP) device support in U-Boot. This
	  allows to download images into memory and execute (jump to) them
	  using the same protocol as implemented by the i.MX family's boot ROM.

config USB_FUNCTION_THOR
	bool "Enable USB THOR gadget"
	help
	  Enable Tizen's THOR download protocol support in U-Boot. It
	  allows downloading images into memory and flash them to target device.

config USB_FUNCTION_ACM
	bool "Enable CDC ACM gadget"
	select SYS_STDIO_DEREGISTER
	select CIRCBUF
	help
	  ACM serial link. This function can be used to create a stdio device to
	  interoperate with MS-Windows hosts or with the Linux-USB "cdc-acm"
	  driver.

config USB_FUNCTION_ACM_LINUX_GADGET_ID
	bool "Gadgets carrying the ACM console present the Linux-USB serial gadget's id"
	depends on USB_FUNCTION_ACM || SPL_USB_GADGET_DNL_ACM
	help
	  Every gadget that carries the CDC ACM console enumerates as
	  0525:a4a7, the id of the Linux-USB serial gadget (g_serial), instead
	  of USB_GADGET_VENDOR_NUM:USB_GADGET_PRODUCT_NUM: the stand-alone
	  usbacm console, and DFU with ACM beside it (USB_GADGET_DNL_ACM,
	  SPL_USB_GADGET_DNL_ACM) in every phase. Strings and serial number
	  are unchanged. Gadgets without ACM (DFU alone, UMS, fastboot,
	  rockusb) keep their id; hosts tell the functions apart by interface.

	  A host that hands CDC ACM devices on only by id needs it: ChromeOS's
	  permission_broker lets a device whose interface cdc_acm has claimed
	  pass to Android or a Linux VM only if its id is on its serial
	  allowlist, and 0525:a4a7 is.

config USB_FUNCTION_ACM_CONNECT_TIMEOUT_MS
	int "How long starting the usbacm console waits for a host (ms)"
	depends on USB_FUNCTION_ACM
	default 0
	help
	  Starting the usbacm stdio device registers the ACM gadget and waits
	  for a host to configure it. 0 waits until one does or Ctrl-C is
	  pressed. A non-zero value gives up after that many milliseconds:
	  the gadget is unregistered and the start fails, so the console runs
	  on without usbacm. A board that adds usbacm to its console by
	  itself needs one, or a boot with no host on the port hangs.

config USB_FUNCTION_ACM_TX_BUF_SIZE
	int "usbacm transmit ring size (bytes)"
	depends on USB_FUNCTION_ACM
	default 2048
	help
	  What the usbacm console keeps while the host is not reading: before
	  it raises DTR, or between reads. When the ring is full the oldest
	  bytes are overwritten.

config USB_GADGET_DNL_ACM
	bool "Serve a CDC ACM console beside DFU in the download gadget"
	depends on USB_FUNCTION_ACM && DFU_OVER_USB && CONSOLE_MUX
	help
	  When the download gadget runs DFU (the `dfu` command), bind a CDC ACM
	  function in the same configuration, so the host that flashes the
	  board also gets its console as /dev/ttyACM*. The console is the
	  stdio device `dnlacm`: list it in stdout/stderr (and stdin) next to
	  `serial`. It never registers the UDC itself; its output is dropped
	  whenever no download gadget is up. UMS, fastboot and the stand-alone
	  `usbacm` console are unchanged. Needs three free data endpoints on
	  the UDC (bulk IN, bulk OUT, interrupt IN); DFU uses ep0 only.

endif # USB_GADGET_DOWNLOAD

config USB_ETHER
	bool "USB Ethernet Gadget"
	depends on NET
	default y if ARCH_SUNXI && USB_MUSB_GADGET
	help
	  Creates an Ethernet network device through a USB peripheral
	  controller. This will create a network interface on both the device
	  (U-Boot) and the host (remote device) that can be used just like any
	  other nework interface.
	  It will bind on the peripheral USB controller, ignoring the USB hosts
	  controllers in the system.

if USB_ETHER

choice
	prompt "USB Ethernet Gadget Model"
	default USB_ETH_RNDIS
	help
	  There is several models (protocols) to implement Ethernet over USB
	  devices. The main ones are Microsoft's RNDIS and USB's CDC-Ethernet
	  (also called CDC-ECM). RNDIS is obviously compatible with Windows,
	  while CDC-ECM is not. Most other operating systems support both, so
	  if inter-operability is a concern, RNDIS is to be preferred.

config USB_ETH_CDC
	bool "CDC-ECM Protocol"
	help
	  CDC (Communications Device Class) is the standard for Ethernet over
	  USB devices. While there's several alternatives, the most widely used
	  protocol is ECM (Ethernet Control Model). However, compatibility with
	  Windows is not that great.

config USB_ETH_RNDIS
	bool "RNDIS Protocol"
	help
	  The RNDIS (Remote Network Driver Interface Specification) is a
	  Microsoft proprietary protocol to create an Ethernet device over USB.
	  Windows obviously supports it, as well as all the major operating
	  systems, so it's the best option for compatibility.

endchoice

config USBNET_DEV_ADDR
	string "USB Gadget Ethernet device mac address"
	default "de:ad:be:ef:00:01"
	help
	  Ethernet MAC address of the device-side (ie. local board's) MAC
	  address of the usb_ether interface

config USBNET_HOST_ADDR
	string "USB Gadget Ethernet host mac address"
	default "de:ad:be:ef:00:00"
	help
	  Ethernet MAC address of the host-side (ie. remote device's) MAC
	  address of the usb_ether interface

endif # USB_ETHER

endif # USB_GADGET

if SPL_USB_GADGET

config SPL_USB_ETHER
	bool "Support USB Ethernet drivers in SPL"
	depends on SPL_NET
	help
	  Enable access to the USB network subsystem and associated
	  drivers in SPL. This permits SPL to load U-Boot over a
	  USB-connected Ethernet link (such as a USB Ethernet dongle) rather
	  than from an onboard peripheral. Environment support is required
	  since the network stack uses a number of environment variables.
	  See also SPL_NET and SPL_ETH.

if SPL_USB_ETHER

choice
	prompt "USB Ethernet Gadget Model in SPL"
	default SPL_USB_ETH_RNDIS
	help
	  There is several models (protocols) to implement Ethernet over USB
	  devices. The main ones are Microsoft's RNDIS and USB's CDC-Ethernet
	  (also called CDC-ECM). RNDIS is obviously compatible with Windows,
	  while CDC-ECM is not. Most other operating systems support both, so
	  if inter-operability is a concern, RNDIS is to be preferred.

config SPL_USB_ETH_RNDIS
	bool "RNDIS Protocol"
	help
	  The RNDIS (Remote Network Driver Interface Specification) is a
	  Microsoft proprietary protocol to create an Ethernet device over USB.
	  Windows obviously supports it, as well as all the major operating
	  systems, so it's the best option for compatibility.

endchoice

endif # SPL_USB_ETHER

config SPL_DFU
	bool "Support DFU (Device Firmware Upgrade) in SPL"
	select SPL_HASH
	select SPL_DFU_NO_RESET
	select SPL_RAM_SUPPORT
	depends on DFU_OVER_USB
	help
	  This feature enables the DFU (Device Firmware Upgrade) in SPL with
	  RAM memory device support. The ROM code will load and execute
	  the SPL built with dfu. The user can load binaries (u-boot/kernel) to
	  selected device partition from host-pc using dfu-utils.
	  This feature is useful to flash the binaries to factory or bare-metal
	  boards using USB interface.

choice
	bool "DFU device selection in SPL"
	depends on SPL_DFU

config SPL_DFU_RAM
	bool "RAM device"
	depends on SPL_DFU && SPL_RAM_SUPPORT
	help
	 select RAM/DDR memory device for loading binary images
	 (u-boot/kernel) to the selected device partition using
	 DFU and execute the u-boot/kernel from RAM.

endchoice

config SPL_DFU_MMC
	bool "MMC back end for DFU in SPL"
	depends on SPL_DFU && SPL_MMC
	help
	  Build drivers/dfu/dfu_mmc.c into SPL, so a DFU session run by SPL can
	  offer raw MMC alternate settings. Only the raw layout is available:
	  SPL has no filesystem writer and no shell, so fat/ext4 and script
	  entities are refused. Whether the alternates can be written is
	  decided by SPL_MMC_WRITE; without it an MMC download fails at the
	  block layer and only uploads (reads) work.

config SPL_DFU_VIRT
	bool "Virtual back end for DFU in SPL"
	depends on SPL_DFU
	help
	  Build drivers/dfu/dfu_virt.c into SPL. A virt alternate has no
	  storage of its own: the board supplies dfu_read_medium_virt(),
	  dfu_write_medium_virt() and dfu_get_medium_size_virt(). The Meson
	  SPL flash session uses it to serve SPI NOR regions read-only through
	  a bare controller reader, without the SPI flash stack.

config SPL_USB_FUNCTION_MASS_STORAGE
	bool "USB mass storage function in SPL"
	depends on SPL_USB_GADGET && SPL_BLK
	help
	  Build f_mass_storage into SPL, so a session run by SPL can export a
	  block device over USB. SPL has no ums command: the caller fills a
	  struct ums, calls fsg_init() and g_dnl_register("usb_dnl_ums"), and
	  runs fsg_main_thread() in its own loop. Whether the LUN can be
	  written is decided by the caller (struct ums ro and write_sector) and
	  by the block device: without SPL_MMC_WRITE an MMC LUN has no write
	  path.

config SPL_USB_GADGET_DNL_ACM
	bool "Serve a CDC ACM console beside DFU in the SPL download gadget"
	depends on SPL_DFU && SPL_SERIAL
	select SPL_CIRCBUF
	help
	  USB_GADGET_DNL_ACM for SPL: when SPL registers the download gadget
	  as usb_dnl_dfu, a CDC ACM function joins DFU in the same
	  configuration (bulk IN, bulk OUT, interrupt IN; DFU uses ep0
	  only), so the host sees the SPL console as /dev/ttyACM*. SPL has no
	  stdio, so every console byte is teed into the ACM console's 4 KiB
	  ring (common/console.c) once the caller has started it with
	  acm_dnl_console_start(); the serial / debug UART output is
	  unchanged. Bytes printed while no DFU gadget is up (a UMS gadget
	  carries no ACM) stay in the ring, oldest overwritten, and reach the
	  next DFU session's ttyACM once its host raises DTR. Input is
	  received but never read.

config SPL_USB_SDP_SUPPORT
	bool "Support SDP (Serial Download Protocol) in SPL"
	depends on SPL_SERIAL
	help
	  Enable Serial Download Protocol (SDP) device support in SPL. This
	  allows to download images into memory and execute (jump to) them
	  using the same protocol as implemented by the i.MX family's boot ROM.

config SPL_SDP_USB_DEV
	int "SDP USB controller index in SPL"
	default 0
	depends on SPL_USB_SDP_SUPPORT
	help
	  Some boards have USB controller other than 0. Define this option
	  so it can be used in compiled environment.

endif # SPL_USB_GADGET
