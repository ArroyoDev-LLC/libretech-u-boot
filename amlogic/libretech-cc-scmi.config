# SCMI client enablement for Libre Computer AML-S905X-CC (libretech-cc).
# Merge after: make libretech-cc_defconfig
#   scripts/kconfig/merge_config.sh -m .config amlogic/libretech-cc-scmi.config
#   make olddefconfig
#
# Not a shipping defconfig. MESON_MHU provider: drivers/mailbox/meson-mhu.c
# (amlogic,meson-gxbb-mhu). Runtime still needs open SC on board + DT
# status=okay — do not merge this fragment into shipping boards yet.

CONFIG_DM_MAILBOX=y
CONFIG_MESON_MHU=y
CONFIG_FIRMWARE=y
CONFIG_SCMI_FIRMWARE=y
CONFIG_SCMI_AGENT_MAILBOX=y
