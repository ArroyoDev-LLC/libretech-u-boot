# G12-C5 first slice: BL33 command to dump the already-trained centre
# and reuse the C6 width walker.  NOT a residual-opensc default, NOT
# every boot, NOT board_init/PREBOOT, NOT a 1D/2D reload.
#
#   make aml-s905d3-cc_defconfig cmd-g12a-dram.config olddefconfig
#
# Layer on residual if you also want the TPL USB residual image:
#   make aml-s905d3-cc_defconfig spl-g12a.config tpl-spl-chain-g12a.config \
#        tpl-g12a-usb-residual.config cmd-g12a-dram.config olddefconfig

CONFIG_CMD_MESON_G12A_DRAM=y
