# For MTK USB3.0 IP

config USB_MTU3
	bool "MediaTek USB3 Dual Role controller"
	depends on USB_XHCI_HCD || USB_GADGET
	depends on ARCH_MEDIATEK
	help
	  Say Y here if your system runs on MediaTek SoCs with
	  Dual Role SuperSpeed USB controller. You can select usb
	  mode as peripheral role or host role.

	  If you don't know what this is, please say N.

if USB_MTU3
choice
	bool "MTU3 Mode Selection"
	default USB_MTU3_GADGET if USB_GADGET
	default USB_MTU3_HOST if (USB_HOST && !USB_GADGET)

config USB_MTU3_HOST
	bool "Host only mode"
	depends on USB_XHCI_HCD
	help
	  Select this when you want to use MTU3 in host mode only,
	  thereby the gadget feature will be regressed.

config USB_MTU3_GADGET
	bool "Gadget only mode"
	depends on USB_GADGET
	select USB_GADGET_DUALSPEED
	help
	  Select this when you want to use MTU3 in gadget mode only,
	  thereby the host feature will be regressed.

endchoice

config USB_MTU3_XHCI_CHILD
	bool "Bind the nested mtk-xhci host child of the mtu3 glue"
	depends on USB_XHCI_MTK
	help
	  The upstream device trees nest an "mediatek,mtk-xhci" host node
	  under the "mediatek,mtu3" glue (mt8183 usb_host, mt8188 xhci0..2).
	  This glue supplies its own .bind, so the DM never scans that child
	  and the standalone xhci-mtk driver never binds -- usb_init() then
	  reports no working controllers even with USB_XHCI_MTK enabled.

	  Say Y to bind xhci-mtk on that child, giving the DFU/UMS gadget and
	  the xhci host on the one SSUSB, without any -u-boot.dtsi surgery.

	  This is opt-in per board because it adds a USB controller that a
	  BOOT_TARGET_USB distro scan will probe at autoboot. Enable it only
	  on boards where the host path has been validated on hardware.

	  If unsure, say N.

config USB_MTU3_DEBUG
	bool "Enable Debugging Messages"
	help
	  Say Y here to enable debugging messages in the MTU3 Driver.

endif
