CONFIG_EFI_LOADER=y
# Board-bootloader policy §6 "Firmware signing & capsule production": the
# bootloader must be updatable by a signed UEFI capsule, with a per-board FMP
# target. On a SPI-NOR board the target writes U-Boot to NOR -- here that is the
# single binman blob u-boot-zynq-nor.bin, so the FMP is ONE image spanning
# 0x0-0x1F0000 (the DFU "bootloader" alt; see board/xilinx/zynq/zynq-adrv9009/
# board.c). Before this, EFI_RUNTIME_UPDATE_CAPSULE was unset and there was no
# FMP at all, so the bootmenu's Firmware Update row -- already #ifdef'd on
# CONFIG_EFI_HAVE_CAPSULE_SUPPORT -- could never compile in.
#
# RAW rather than FIT backend: the artifact is a flat blob at a fixed NOR
# offset, which is exactly what the raw FMP writes (it selects DFU +
# DFU_WRITE_ALT). CAPSULE_ON_DISK adds the EFI\UpdateCapsule path on the ESP
# alongside the in-memory `efidebug capsule update` the menu uses; it needs
# SYSRESET, which this board gained in 15d5a75e156.
#
# AUTHENTICATE with the same in-repo public certificate the Amlogic SPI-NOR
# reference board (aml-s905d3-cc) uses. Policy §6 is explicit that this is an
# OPEN platform -- the key is not treated as a secret and nothing fuses a root
# of trust -- but the capsule itself is signed for integrity and fwupd identity,
# and an unsigned or foreign-signed capsule is REJECTED BEFORE ANY WRITE, which
# is the property that matters on a board whose only recovery path is JTAG.
# The build turns the .pem into an ESL with cert-to-efi-sig-list (efitools) and
# embeds it in the binary.
#
# CMD_EFIDEBUG is what the bootmenu entry invokes; it was not enabled.
CONFIG_EFI_RUNTIME_UPDATE_CAPSULE=y
CONFIG_EFI_CAPSULE_ON_DISK=y
CONFIG_EFI_CAPSULE_FIRMWARE_RAW=y
CONFIG_EFI_CAPSULE_AUTHENTICATE=y
CONFIG_EFI_CAPSULE_CRT_FILE="board/libre-computer/common/eficapsule.pub.pem"
CONFIG_CMD_EFIDEBUG=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_ULPI=y
CONFIG_USB_GADGET=y
# USB gadget identity. Board-bootloader policy §2 "USB-gadget modes & identity"
# requires all gadget modes to present the board's real manufacturer and the
# board name; the Xilinx defaults said manufacturer "Xilinx" / product "U-Boot",
# i.e. neither. This is a third-party carrier, so the honest manufacturer is
# HamGeek (matching the DTS model "HamGeek XC7Z100 ADRV9009 (RIGUKE)" and the
# hamgeek,xc7z100-adrv9009 compatible), not the "Libre Computer" literal policy
# uses for our own boards.
#
# VID:PID stays 03fd:0300. Policy says explicitly that "the USB VID/PID are not
# significant", and the recovery tooling for this board keys on that pair.
# iSerialNumber comes from the env serial#, derived in board.c from the W25Q256
# factory UID.
CONFIG_USB_GADGET_MANUFACTURER="HamGeek"
CONFIG_USB_GADGET_PRODUCT="XC7Z100-ADRV9009"
CONFIG_USB_GADGET_VENDOR_NUM=0x03fd
CONFIG_USB_GADGET_PRODUCT_NUM=0x0300
CONFIG_CI_UDC=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_SYS_TIMER_COUNTS_DOWN=y
# BL33 compression, per the BL33 compression policy: LZ4 first, LZMA only with a
# recorded shortfall, GZIP banned outright (strictly dominated -- worse ratio
# than LZMA, slower than LZ4). LZ4 is what the ladder in
# arch/arm/dts/zynq-sdr-nor-u-boot.dtsi selects off this symbol, and it drives
# BOTH the FIT `compression` metadata and the binman `compress` property, so the
# label and the payload can never disagree.
#
# LZ4 is taken and LZMA is NOT, because there is no shortfall to record: LZ4
# brings the blob well inside the 0x1F0000 gate on its own, and LZ4 decompresses
# far faster than LZMA. Measured on u-boot-nodtb.bin (845 184 B uncompressed):
# LZ4 539 082 B = 63.78% of uncompressed, LZMA 326 275 B = 38.60%. The policy
# ladder only reaches for LZMA when LZ4's ratio does not fit.
#
# This REPLACES a "no SPL decompressor" arrangement whose stated blocker was
# real and is now resolved: the Makefile's mkimage "-f auto" path CANNOT
# compress -- it writes the payload raw and only stamps the compression property
# -- so a -C lz4 there yields a FIT that lies about its contents and an SPL that
# ulz4fn()s raw ARM code. The fix is the layer that owns the artifact: the
# binman `u-boot-img` entry is replaced by an explicit `fit` node whose
# u-boot-nodtb subentry carries `compress`, which is what actually runs the
# compressor. Prior to that, CONFIG_SPL_GZIP=y was set here against a FIT
# marking every entry compression = "none", i.e. 13 064 B of unreachable SPL
# text.
CONFIG_SPL_LZ4=y
# USB-OTG gadget: reflash/write storage over USB (usb@e0002000, ChipIdea UDC via
# ci_udc + ehci-zynq ULPI). This adds UMS + fastboot on top of the DFU-over-USB
# already enabled above (CMD_DFU + DFU_MMC/DFU_SF/DFU_RAM; DFU_OVER_USB is
# auto-selected -- there is no CONFIG_USB_FUNCTION_DFU symbol in this u-boot).
# The core (USB=y, USB_GADGET=y, CI_UDC=y, USB_GADGET_DOWNLOAD=y, USB_ULPI=y,
# Xilinx VID/PID) is set above; DM_USB, USB_EHCI_ZYNQ, USB_ULPI_VIEWPORT and
# USB_GADGET_DUALSPEED come in as ARCH_ZYNQ/select defaults.
# UMS: `ums 0 mmc 0` exposes the SD as a USB mass-storage device to the host
# (host then dd's the armhf image straight onto it -- no card pull). Selects
# USB_FUNCTION_MASS_STORAGE.
CONFIG_CMD_USB_MASS_STORAGE=y
# fastboot over USB: `fastboot usb 0`. USB_FUNCTION_FASTBOOT selects FASTBOOT +
# USB_GADGET_DOWNLOAD and implies CMD_FASTBOOT (set explicitly too).
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_CMD_FASTBOOT=y
# fastboot flash target = SD (mmc dev 0). FASTBOOT_FLASH selects IMAGE_SPARSE.
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
# Download buffer in DRAM (Zynq-7100 has >=1 GiB). 0x10000000 (256 MiB) is clear
# of SPL BSS/stack (0x100000/0x200000) and the u-boot text base (0x04000000).
CONFIG_FASTBOOT_BUF_ADDR=0x10000000
CONFIG_FASTBOOT_BUF_SIZE=0x10000000
