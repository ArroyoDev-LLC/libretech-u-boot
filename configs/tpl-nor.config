# TPL SPI NOR, READ ONLY -- layered on a -libre defconfig + tpl-spl-chain.config:
#   make libretech-cc_v2_libre_defconfig tpl-spl-chain.config tpl-nor.config \
#        olddefconfig
#
# This is a DIAGNOSTIC fragment, not a boot source.  It builds the SPI flash
# CONTROLLER into the SRAM stage and issues two opcodes -- 0x9F (read
# identification) and 0x03 (read data) -- so the clock/pinmux/controller path
# can be proven end to end on real silicon.  It does NOT build the spi-nor
# core, so no erase and no write callback and no WREN opcode exists in the
# stage at all.  See TPL_MESON_GX_NOR_PROBE's help text.
#
# WHY IT DOES NOT STACK WITH tpl-mmc.config -- now LINKED rather than added up.
# The earlier note here added the two arms' costs and got 58638 B against the
# 45056 B (0xb000) ceiling, i.e. over by 13582.  That was arithmetic, and it
# double-counted everything the two arms share (TPL_DM, TPL_OF_*, libfdt,
# simple-bus).  Built together on lc-master 0c9b458dffa the link says:
#
#   ld: region `.sram' overflowed by 3640 bytes
#
# so the real demand is 48696 B, over by 3640 -- roughly a quarter of the
# claimed shortfall.  Still does not fit, and still both-arms-together is not a
# configuration anything ships, but the gap is small enough that "separate
# per-medium images" is a CHOICE and no longer a forced move.  Do not "fix" it
# by dropping TPL_SERIAL: a stage that reads a JEDEC ID and cannot say what it
# read has measured nothing (that lesson is 2026-08-12, when a console-less TPL
# made its own DDR verdict unobservable).  The shape question is N30 --
# amlogic/software/boot/gxl/design/tpl-per-medium-shape.md.

# The SPI uclass and the DM plumbing under it.  TPL_DM/TPL_OF_* mirror what
# tpl-mmc.config sets for the same reason: the controller is described by a
# device tree node, and its chip select comes from the /aliases spi0 entry.
CONFIG_TPL_DM=y
CONFIG_TPL_SPI=y
CONFIG_TPL_DM_SPI=y
CONFIG_TPL_DM_SEQ_ALIAS=y
CONFIG_TPL_OF_CONTROL=y
CONFIG_TPL_OF_REAL=y
CONFIG_TPL_OF_TRANSLATE=y
CONFIG_TPL_OF_LIBFDT=y

# NO CONFIG_TPL_SIMPLE_BUS LINE HERE, and its absence is the point.
#
# The controller hangs off cbus, a "simple-bus", and without that driver the
# node never binds -- so neither does anything under it.  Measured 2026-08-12 on
# hardware, which is the only reason it was found at all: the TPL printed
# "Invalid bus 0 (err=-19)" while spi@8c80 sat in its own pruned device tree,
# correctly muxed, with the controller driver linked.
#
# The first version of this fragment carried CONFIG_TPL_SIMPLE_BUS=y.  That was
# the wrong layer: drivers/core/Kconfig gave SIMPLE_BUS and SPL_SIMPLE_BUS
# `default y` and gave TPL_SIMPLE_BUS none, with an otherwise identical
# `depends on` shape -- an omission in the phase triplet, not a preference.  The
# `default y` now lives there, so this fragment does not have to name it, and
# tpl-mmc.config gets the same repair for free (apb@d0000000 is a simple-bus
# too, and no TPL had ever bound a card to notice).

# meson_spifc_probe() opens with regmap_init_mem().  TPL_REGMAP is a prompt-less
# bool nothing selects -- the same shape as the TPL_SPRINTF/TPL_STRTO gap closed
# in the dm:blk commit on this branch -- but TPL_SYSCON has a prompt and selects
# it, so one line closes it without a new Kconfig change.
CONFIG_TPL_SYSCON=y

# NO PINCTRL UCLASS, and this one IS a size decision rather than a design one.
#
# The board's BOOT_11/12/13/15 pins are muxed to nor_d/q/c/cs by u-boot proper,
# not by the ROM: on the USB dev loop the ROM booted over the cable and never
# touched them, so the stage has to do it.  Doing it with the driver was tried
# and measured first:
#
#   CONFIG_TPL_PINCTRL + TPL_PINCTRL_FULL + TPL_PINCTRL_MESON_GXL
#     -> region '.sram' overflowed by 15264 bytes  (a 23293 B driver, almost
#        all of it the GXL pin-name and group tables, against a stage with
#        8029 B spare)
#
# So tpl-nor-probe.c writes the four mux bits itself -- one read-modify-write
# of PERIPHS_PIN_MUX_7, printed before and after.  Same shape as the answer the
# MMC path reached for SD_EMMC_CLOCK on 2026-08-07: the stage needs a register
# programmed, not a framework.
# CONFIG_TPL_PINCTRL is not set

# MESON_SPICC is a SEPARATE, unrelated driver that libretech-cc_v2_defconfig
# also enables, and it is undefined on dm_gpio_set_value in a phase without
# TPL_DM_GPIO.  Left on it costs a link failure and 1424 B of .sram overflow
# that have nothing to do with the flash controller.
# CONFIG_MESON_SPICC is not set

CONFIG_TPL_MESON_GX_NOR_PROBE=y
