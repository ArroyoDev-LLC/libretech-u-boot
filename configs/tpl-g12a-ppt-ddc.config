# Opt-in LPDDR4 PPT/DDC after 1D/2D.  NOT a residual-opensc default.
#
#   make aml-s905d3-cc_defconfig spl-g12a.config tpl-spl-chain-g12a.config \
#        tpl-g12a-usb-residual.config tpl-g12a-ppt-ddc.config olddefconfig
#
# Closed aml_ddr.fw T7 writes PPTTrainSetup = 0.  This fragment arms the
# Synopsys phyinit default interval (PUB §11.3.227) on one residual boot.
# Leave residual-opensc without this fragment so DDC stays off.

CONFIG_MESON_G12A_PPT_DDC=y
