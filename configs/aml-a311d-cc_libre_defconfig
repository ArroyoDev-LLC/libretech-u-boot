CONFIG_MESON_G12A_XPL_CHAIN=y
CONFIG_MESON_G12A_LIBRE_SECURE_LAYOUT=y
# G12B board power (dual-cluster VCCK_A/B + VDDEE) from spl-g12b.c, layered
# under the SM1 orchestrator instead of replacing it.
CONFIG_MESON_G12B_POWER_INIT=y
# USB-BROM inner loop: TPL residual so the host can push train FW + SPL.
# Without this the TPL trains, prints HO, and jumps to empty DRAM (NOSPL).
# BSS at 0xfffb0000: 0xfffbc000 sits inside the aml_ddr blob window.
CONFIG_TPL_MESON_G12A_USB_RESIDUAL=y
# SPL_LZMA's decoder mallocs its probability table (14080 B for a binman
# -lc1 -lp0 stream) out of the SYS_MALLOC_SIMPLE bump arena; 0x1000 is where
# GXL died with "alloc space exhausted ptr 38a8 limit 1000".  0x8000 is the
# value proven on GXL silicon and costs zero image bytes -- it is a
# pre-relocation arena, not image content.  The arena sits directly under
# CONFIG_SPL_STACK, and 0x8000 under the old SRAM stack (0xfffb3000) would
# cover the SPL BSS at 0xfffb0000, so the stack moves to DRAM 0x09000000 as
# on SM1: above the DRAM stage (0x08000000 + 0x40000), clear of the FIT
# staging at SYS_LOAD_ADDR and of the 16 MiB secure block at 0.
CONFIG_SPL_SYS_MALLOC_F_LEN=0x8000
# TPL_SYS_MALLOC_F_LEN defaults to SPL_SYS_MALLOC_F_LEN.  The TPL has no
# decompressor and runs from SRAM at 0xfffa1000 against the aml_ddr blob
# window, so pin it back to what it was rather than let the SPL raise move it.
CONFIG_TPL_SYS_MALLOC_F_LEN=0x1000
