# BL33 compression, per the BL33 compression policy: LZ4 first, LZMA only with a
# recorded shortfall, GZIP banned outright (strictly dominated -- worse ratio
# than LZMA, slower than LZ4). The ladder in
# arch/arm/dts/zynq-sdr-nor-u-boot.dtsi selects off this symbol and drives BOTH
# the FIT `compression` metadata and the binman `compress` property, so the
# label and the payload can never disagree. No shortfall to record here: LZ4
# already clears the 0x1F0000 gate with a wide margin, so the ladder does not
# reach for LZMA.
#
# This REPLACES a "no SPL decompressor" arrangement whose stated blocker was
# real and is now resolved: the Makefile's mkimage "-f auto" path CANNOT
# compress -- it writes the payload raw and only stamps the compression property
# -- so a -C lz4 there yields a FIT that lies about its contents and an SPL that
# ulz4fn()s raw ARM code. The fix is the layer that owns the artifact: the
# binman `u-boot-img` entry is replaced by an explicit `fit` node whose
# u-boot-nodtb subentry carries `compress`, which is what actually runs the
# compressor. Prior to that, CONFIG_SPL_GZIP=y was set here against a FIT
# marking every entry compression = "none", i.e. 13 064 B of unreachable SPL
# text.
#
# The FIT offset (CONFIG_SYS_SPI_U_BOOT_OFFS=0x40000 above) does NOT move: it is
# already the derived floor -- the smallest 64 KiB-erase-aligned offset above
# CONFIG_SPL_MAX_SIZE (0x30000), which is itself the 192 KiB low-OCM window the
# Zynq SPL executes from. The gap below it is the SPL's silicon-capped growth
# reserve, not fixed-offset filler.
CONFIG_SPL_LZ4=y
# SPI NOR config sector (board-bootloader policy "SPI NOR config sector"):
# one 64 KiB erase block at 0x1F0000 of plain-text key=value env *overrides*,
# imported by board_config_env_import() from misc_init_r(). The env proper stays on the
# ESP FAT (ENV_IS_IN_FAT above). Backend hooks: board/xilinx/zynq/zynq-e310/board.c.
CONFIG_BOARD_CONFIG=y
# PINNED at the value this board has always used, and it must stay pinned --
# but NOT merely because the board cannot report a size. It cannot (its read
# path is spi_flash_probe_bus_cs(), which needs driver model, and the block is
# read before driver model exists), and that alone no longer decides anything:
# an unmeasurable board now DEFAULTS to the last block of the addressable
# window, 0xFF0000. The reason to pin is that 0xFF0000 is occupied here.
#
# This board's 32 MiB W25Q256 is tiled by three DFU alts in board.c with no
# gaps and no overlap: "bootloader raw 0x0 0x1f0000", "config raw 0x1f0000
# 0x10000", "spare raw 0x200000 0x1e00000". 0xFF0000 is inside that last one,
# so the config block would sit in the middle of a 30 MiB region offered as a
# single writable alt -- one `dfu` write of a spare image erases it, silently,
# and the block is also where a golden copy of the bootloader blob lives.
# Moving the block would mean splitting "spare" in two around a 64 KiB hole
# and giving up whole-region writes, to gain nothing: 0x1F0000 is free,
# erase-block aligned, and is already what LBS_TARGET_MAX_SIZE=0x1F0000
# (configs/xilinx-zynq7) gates the bootloader blob against, so the blob
# provably cannot grow into it.
CONFIG_BOARD_CONFIG_NOR_OFFSET_PIN=y
CONFIG_BOARD_CONFIG_NOR_OFFSET=0x1F0000
# Overlay half OFF. The E310 ships no .dtbo set, and NOR 0x200000 -- the
# default CONFIG_BOARD_CONFIG_NOR_FIT_OFFSET -- holds the golden copy of the
# bootloader blob, which would be parsed as a FIT. Leaving it off also keeps
# fdtdec_board_setup() out of the image entirely.
# CONFIG_BOARD_CONFIG_OVERLAYS is not set
# Platform boot-source variables (policy §4 "Boot source variables"): not on
# by default here because SYS_VENDOR is "xilinx", so it is opted into.
CONFIG_BOOTSOURCE=y
