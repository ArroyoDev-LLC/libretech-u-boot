# Open-chain TPL->SPL boot for AML-S805X-AC (La Frite). Product is
# libretech-ac_defconfig (vendor BL2, no open SPL). This defconfig is product +
# USB TPL + the TPL/SPL chain + DDR4 @ 1080 / ONE 16-BIT RANK. Used by LBS
# aml-s805x-ac-libre.
#
# The chain half (CONFIG_TPL*, CONFIG_MESON_GX_XPL_CHAIN,
# CONFIG_TPL_MESON_USB_BOOT, CONFIG_SPL_TEXT_BASE=0x08000000,
# CONFIG_SPL_PAYLOAD) used to be a separate configs/tpl-spl-chain.config
# fragment stacked on top of this file by the LBS target. It is folded in here:
# a defconfig is the only config home this tree keeps, and a fragment stack is a
# second one that drifts.
#
# This is the SINGLE-CHIP DDR4 sibling of libretech-cc_v2_libre_defconfig: one
# x16 device on one chip select, against Sweet Potato's two x16 devices on a
# 32-bit bus. Until this file existed, CONFIG_DRAM_16BIT_RANK was a Kconfig
# choice that NO defconfig selected, so every 16-bit code path in dram-gx.c /
# dram-gxl.c / dram-settings-gx.h was carried but never compiled.
#
# Every DDR value below is read from this board's OWN vendor boot-lite files,
# not copied from the Sweet Potato:
#
#   vendor/amlogic/boot-lite/configs/aml-s805x-ac.h
#     CONFIG_DDR4_CLK            1080              -> CONFIG_DRAM_CLK=1080
#     CONFIG_DDR_TYPE            ..._DDR4          -> CONFIG_DRAM_DDR4=y
#     CONFIG_DDR_CHANNEL_SET     CONFIG_DDR0_16BIT -> CONFIG_DRAM_16BIT_RANK=y
#     CONFIG_DDR_SIZE            0 (auto-detect)   -> no size asserted here
#     CONFIG_VDDEE_INIT_VOLTAGE  1000
#   vendor/amlogic/boot-lite/board/aml-s805x-ac/firmware/power.c
#     pwm_voltage_table 1000 mV  0x0e000e          -> CONFIG_MESON_GXL_VDDEE_PWM_B
#   vendor/amlogic/boot-lite/board/aml-s805x-ac/firmware/timing.c
#     .ddr_2t_mode               1                 -> CONFIG_DRAM_2T_MODE=y
#
# CONFIG_MESON_GXL_VDDEE_PWM_B is 0xe000e, the same word Sweet Potato uses, and
# that is a coincidence of two boards both running VDDEE at 1000 mV off an
# identical PWM table -- it is derived from La Frite's own power.c, which is
# what the Kconfig help text requires. Do not propagate it further by assuming.
#
# CONFIG_DRAM_SIZE is deliberately NOT set. It is a Kconfig int no code in the
# tree reads, and its presence in the Sweet Potato file was misread as a size
# cap for a month (see amlogic/software/boot/gxl/ddr4-spl-timing-gaps.md
# "TRUE SIZE"). Size comes from meson_dram_detect_size(), bounded by
# DDR_DETECT_MAX_MB, which the 16-bit arm of MESON_DRAM_RANK0_MB sets to 1 GB.
#
# CONFIG_DRAM_DQS_CORR=y uses PUB_WR_ADJ_PER / PUB_RD_ADJ_PER from
# dram-settings-gx.h, whose 16-bit arm carries THIS board's vendor
# .rd_adj_per -- a uniform 95, where Sweet Potato's is {..,88,95,95,100}.
#
# The open-chain NS SCMI agent block that libretech-cc_v2_libre_defconfig
# carries is deliberately absent: GXL open SCMI is a Sweet Potato bring-up
# (amlogic/software/boot/gxl/scmi-plan.md) and nothing here has been tested
# against it.
#
CONFIG_ARM=y
