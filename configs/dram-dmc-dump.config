# DIAGNOSTIC overlay -- read the programmed DMC geometry back off silicon.
#
# Stack it LAST, on top of the board's -libre defconfig and the chain
# fragment, so nothing it turns on can be re-clobbered:
#
#   make libretech-cc_libre_defconfig tpl-spl-chain.config \
#        dram-dmc-dump.config olddefconfig
#
# What it buys: one line at the end of meson_dram_dmc_init(), after
# meson_dram_dmc_set_addrmap() has written the map and before the first DRAM
# access --
#
#   DMC: ctrl=<DMC_DDR_CTRL> map=<DDR0_ADDRMAP_0..4> detect<=<N>MB
#
# which is the only way to confirm that the words this branch programs are the
# words the controller ends up holding.  It adds no register write.
#
# It runs in board_init_f, so in the TPL->SPL chain it lands in PASS 1 -- the
# half of the flow that works on every GXL rig on the fleet, including the ones
# where pass 2 cannot deliver a FIT.
CONFIG_MESON_GX_DMC_DUMP=y
