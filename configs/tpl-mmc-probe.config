# TPL SD/eMMC read probe, layered ON TOP of tpl-mmc.config:
#   make libretech-cc_v2_libre_defconfig tpl-spl-chain.config tpl-mmc.config \
#        tpl-mmc-probe.config olddefconfig
#
# A DIAGNOSTIC, not a boot source, and a separate fragment from tpl-mmc.config
# on purpose: the product arm's size is a number this project quotes, and it
# must not move because a bring-up rig wanted a probe.  tpl-mmc.config stays
# the boot-source arm; this fragment is the thing you add on the bench.
#
# It exists because the loader tpl-mmc.config enables cannot be executed on the
# USB dev loop at all: gx_tpl_fetch_spl() dispatches on
# meson_get_boot_device(), which reports BOOT_DEVICE_USB there, so the SD/eMMC
# case is never entered.  Exactly the reason TPL_MESON_GX_NOR_PROBE exists, and
# the same remedy -- see arch/arm/mach-meson/tpl-mmc-probe.c.
CONFIG_TPL_MESON_GX_MMC_PROBE=y
