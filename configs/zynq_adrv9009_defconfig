CONFIG_SET_DFU_ALT_INFO=y
CONFIG_SYS_DFU_DATA_BUF_SIZE=0x600000
CONFIG_FPGA_XILINX=y
CONFIG_FPGA_ZYNQPL=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ZYNQ=y
CONFIG_SPI_FLASH_ISSI=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_SPANSION=y
CONFIG_SPI_FLASH_STMICRO=y
CONFIG_SPI_FLASH_SST=y
CONFIG_SPI_FLASH_WINBOND=y
# CONFIG_SPI_FLASH_USE_4K_SECTORS is not set
CONFIG_SPI_FLASH_MTD=y
CONFIG_DM_ETH_PHY=y
CONFIG_MII=y
CONFIG_ZYNQ_GEM=y
CONFIG_PHY_MARVELL=y
CONFIG_PHY_REALTEK=y
# Board-bootloader policy §2 "CPU power management & reset": reset must go
# through the SYSRESET uclass; an arch-specific reset_cpu() is a violation.
# SYSRESET_ZYNQ (drivers/sysreset/sysreset_zynq.c) is the SLCR sequence
# mach-zynq/cpu.c used to open-code. NOT syscon-reboot: the SLCR is
