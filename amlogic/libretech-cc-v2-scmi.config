# SCMI client enablement for Libre Computer AML-S905X-CC-V2 (libretech-cc_v2).
# Merge after: make libretech-cc_v2_libre_defconfig
#   scripts/kconfig/merge_config.sh -m .config amlogic/libretech-cc-v2-scmi.config
#   make olddefconfig
#
# v2 libre fragment only — not libretech-cc_v2_defconfig (vendor BL2) and
# not v1 libretech-cc. MESON_MHU provider: drivers/mailbox/meson-mhu.c
# (amlogic,meson-gxbb-mhu). Compile-proof only until open SC is on M3.

CONFIG_DM_MAILBOX=y
CONFIG_MESON_MHU=y
CONFIG_FIRMWARE=y
CONFIG_SCMI_FIRMWARE=y
CONFIG_SCMI_AGENT_MAILBOX=y
