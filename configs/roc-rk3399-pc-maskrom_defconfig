# The ACM console starts with the boot so far, from the TPL's banner. The log
# sits below the session's RAM alternates (0x10000000) and clear of the
# MaskROM 472 load (SPL at 0, FIT at 0x80000), ATF, U-Boot (0x800000) and the
# SPL heap and stack (below 0x3e00000).
CONFIG_TPL_XPL_BOOTLOG=y
CONFIG_SPL_XPL_BOOTLOG=y
CONFIG_XPL_BOOTLOG_ADDR=0x0e000000
# The SPL checks the FIT's sha256 hashes and verifies no signature (the FIT
# carries no keys): RSA and SHA1, which SPL_FIT_SIGNATURE only implies, are
# dead weight here, and dropping them pays for the ACM console.
# CONFIG_SPL_RSA is not set
# CONFIG_SPL_SHA1 is not set
# The session's UMS after DFU needs a freshly probed DWC3, as proper's `ums`
# gets: without device removal the reused controller never completes the
# first bulk OUT (the host's first CBW) and the host resets the device.
CONFIG_SPL_DM_DEVICE_REMOVE=y
CONFIG_USB_GADGET_MASS_STORAGE_READ_FILL=0x10000
