#
# U-Boot SPL fragment for libretech-cc -- BOTH the 1 GB and the 2 GB board.
#
# There is deliberately no per-capacity variant.  A DRAM config states the
# MAXIMUM the board could carry and the board settles the rest at runtime:
# dram_init() trains two ranks first and drops to one if that training FAILS,
# then meson_dram_detect_size() reports what is actually there.  So one
# fragment covers both SKUs and the 1 GB board is not a second configuration.
#
# This replaces spl-libretech-cc-1gb.config and spl-libretech-cc-2gb.config,
# which were byte-identical apart from the rank line -- ONE_RANK against
# TWO_IDENTICAL_RANKS -- and are the reason the split existed at all.
#

CONFIG_SPL=y
CONFIG_SPL_LIBCOMMON_SUPPORT=y
CONFIG_SPL_LIBGENERIC_SUPPORT=y
CONFIG_SPL_TEXT_BASE=0xd9001000
CONFIG_SPL_STACK=0xd9013000
CONFIG_SPL_HAS_BSS_LINKER_SECTION=y
# 0xd900d000, not 0xd900c000: BSS_MAX_SIZE below is 0x1000, so starting at
# 0xd900c000 spans 0xd900c000-0xd900d000 and swallows the ENTIRE named SRAM
# window (GX_SRAM_BROM_PARAM_ADDR .. GX_SRAM_WINDOW_END 0xd900c400) -- the
# breadcrumb + handoff block that must SURVIVE the stage boundary -- and then
# BL1_NAND_BUFF beyond it. Every shipping profile uses 0xd900d000.
CONFIG_SPL_BSS_START_ADDR=0xd900d000
CONFIG_SPL_HAVE_INIT_STACK=y
CONFIG_SPL_BSS_MAX_SIZE=0x1000
CONFIG_SPL_SYS_MALLOC_SIMPLE=y
# CONFIG_SPL_SHARES_INIT_SP_ADDR is not set
# CONFIG_SPL_SERIAL_PRESENT is not set
CONFIG_SPL_SHA256=y
# CONFIG_SPL_SHA1 is not set

# Enable MMC and serial drivers
CONFIG_SPL_SERIAL=y
CONFIG_SPL_DRIVERS_MISC=y
CONFIG_SPL_MMC=y
CONFIG_SPL_SYS_MMCSD_RAW_MODE=y
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x100
# CONFIG_SYS_MMCSD_FS_BOOT is not set

# Image things
CONFIG_SPL_LOAD_FIT=y
CONFIG_SPL_MAX_SIZE=0xb000
CONFIG_SPL_PAD_TO=0x1fe00
CONFIG_SPL_ATF=y
CONFIG_SPL_OF_CONTROL=y
# DRAM configuration.  No size: the DMC is sized from the address map and then
# from meson_dram_detect_size(); CONFIG_DRAM_SIZE was read by nothing.
CONFIG_DRAM_2T_MODE=y
CONFIG_DRAM_DQS_CORR=y
CONFIG_DRAM_TWO_IDENTICAL_RANKS=y
