# Env proper lives on the boot media's EFI/FAT partition, per Libre Computer
# bootloader policy §4 ("Environment storage: a filesystem, never a raw block" --
# never a raw offset, and never in NOR; the NOR config sector holds *overrides*
# only). Same backend as zynq_e310_defconfig and aml-s905d3-cc_defconfig.
#
# This REPLACES an earlier env-in-QSPI-NOR arrangement (ENV_IS_IN_SPI_FLASH at a
# raw ENV_OFFSET=0x200000) whose stated goal was to keep the SD a clean generic
# armhf EFI Debian with no board-specific boot state on it. That goal lost to
# policy §4, and the raw offset was independently unsafe: with the FIT at the
# then-current 0x120000 the blob ran to 0x1e4000, so a raw env at 0x200000 sat
# only 112 KiB past it and a slightly larger U-Boot would silently overwrite the
# env -- exactly the invisible-reservation collision §4 exists to prevent. The
# board's dedicated "bootenv" partition at 0x500000 was never used by it either.
# (Under the 2026-07-31 layout 0x200000 is the QSPI boot-script slot; see
# board/xilinx/zynq/zynq-adrv9009.env.)
#
# Do NOT enable ENV_IS_NOWHERE: a missing uboot.env must fall back to the
# built-in defaults, not to a no-op env.
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_FAT=y
CONFIG_ENV_FAT_INTERFACE="mmc"
CONFIG_ENV_FAT_DEVICE_AND_PART=":auto"
CONFIG_ENV_FAT_FILE="uboot.env"
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# NOR config sector (policy §4): one erase block of plain-text key=value
# environment *overrides*, DFU-writable, so boot_targets / overlays / a
# provisioned ethaddr can be changed on a unit without rebuilding U-Boot. Read at
# misc_init_r() by board_config_env_import(); the board_nor_* hooks are in
# board/xilinx/zynq/zynq-adrv9009/board.c.
#
# OFFSET IS THE POLICY DEFAULT, 0x1F0000, since 2026-07-31. It was 0x2F0000, and
# the reason it had to be is gone: 0x2F0000 was chosen as "the last 64 KiB-aligned
# block below the 0x300000 bitstream" only because a blob anchored at the legacy
# FIT offset 0x120000 already reached 0x1E7440 and could not clear 0x1F0000 with
# any headroom. With the FIT moved to its derived floor (0x40000, see
# SYS_SPI_U_BOOT_OFFS above) and BL33 LZ4-compressed (SPL_LZ4 below), the blob
# ends around 0xC8000 and 0x1F0000 clears it by ~1.2 MiB, so this board stops
# carrying a bespoke config-sector offset. That also frees the whole
# 0x1F0000-0x300000 span for the boot-script slot and spare.
#
# The two hard constraints that shaped the old value still hold and 0x1F0000
# satisfies both:
#  - It must stay BELOW the stock 17 416 352 B PL bitstream at 0x300000-0x139C0A0
#    (documented byte-for-byte in rf/rfsim/reference/adrv9009-qspi-nor-contents.md,
#    claude repo). 0x1F0000 is 1 114 112 B below it.
#  - It must stay BELOW 0x1000000 (16 MiB). U-Boot proper on this board has NO
#    4-byte addressing: the device measures SR3 = 0x60 (ADS = 0, ADP = 0) at the
#    U-Boot prompt AFTER "SF: Detected w25q256", i.e. after spi_nor_init(),
#    sampled three times and identical from Linux; CONFIG_SPI_FLASH_BAR is off in
#    U-Boot proper (only SPL_SPI_FLASH_BAR is set), and the w25q256 entry
#    (0xef4019) carries neither SPI_NOR_4B_OPCODES nor a Spansion mfr. An access
#    at or above 16 MiB truncates -- an earlier draft that put this at 0x1400000
#    would have resolved to 0x400000, INSIDE the bitstream, so a config-sector
#    write would have corrupted PL configuration data while reporting success.
#
# The bound is ENFORCED, not just documented: configs/xil-z7100-sdr in
# libretech-builder-simple now inherits LBS_TARGET_MAX_SIZE=0x1F0000 from
# configs/xilinx-zynq7 (its 0x2F0000 override is removed), so a bootloader blob
# that ever grows into the config sector fails the build. The DFU alt map in
# board.c uses the same boundary.
CONFIG_BOARD_CONFIG=y
# PINNED, and it must stay pinned. The default is now the last 64 KiB of the
# addressable device -- min(size, 16 MiB) - 64 KiB, and 0xFF0000 outright when
# the size cannot be measured, which is this board's case. Either way it is
# 0xFF0000, and 0xFF0000 is inside the 17 416 352 B stock PL bitstream at
# 0x300000-0x139C0A0. A config write there destroys PL configuration data
# while reporting success. See board.c's DFU alt map.
#
# The pin also matches the write side with nothing further to do: board.c
# compiles in "config raw 0x1f0000 0x10000" and the capsule FMP alt stops at
# this same boundary, which is LBS_TARGET_MAX_SIZE for configs/xil-z7100-sdr.
CONFIG_BOARD_CONFIG_NOR_OFFSET_PIN=y
CONFIG_BOARD_CONFIG_NOR_OFFSET=0x1F0000
# Platform boot-source variables (policy §4 "Boot source variables"): not on
# by default here because SYS_VENDOR is "xilinx", so it is opted into.
CONFIG_BOOTSOURCE=y
# No CONFIG_BOOT_SCRIPT_OFFSET, and no QSPI boot target: SPI NOR on a Libre
# Computer board carries no boot script (policy §4 -- bootloader blob, config
# sector, overlay FIT, and nothing else), and the per-unit override surface is
# the config sector selected just above. CONFIG_BOARD_CONFIG is what
# switches both off; see include/configs/zynq-common.h (the boot target) and
# board/xilinx/common/board.c (the script_offset_f assignment). An earlier
# revision set CONFIG_BOOT_SCRIPT_OFFSET=0x200000 here, which pointed the
# script reader at the overlay-FIT region.
# No DT overlay FIT on this board: OF_OVERLAY_LIST is empty and there is no
# .dtbo set (the radio arrives via a userspace overlay after Linux programs the
# PL). BOARD_CONFIG_OVERLAYS defaults to y and would parse whatever happens to sit
# at its default 0x200000 -- which on this unit is inside the bootloader region.
# It also installs fdtdec_board_setup(). Both are wrong here.
# CONFIG_BOARD_CONFIG_OVERLAYS is not set
CONFIG_SPL_DM_SEQ_ALIAS=y
CONFIG_SIMPLE_PM_BUS=y
CONFIG_DFU_TIMEOUT=y
CONFIG_DFU_MMC=y
CONFIG_DFU_RAM=y
CONFIG_DFU_SF=y
